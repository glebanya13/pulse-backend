# Postgres connection string used by Prisma and the Nest app.
# When running via docker-compose, host "postgres" resolves to the db container (see docker-compose.yml,
# which sets DATABASE_URL itself for the `api` service).
# When running the Nest app locally (npm run start:dev) against `docker compose up -d postgres`,
# use "localhost" and port 5433 — the container publishes on 5433 instead of the default 5432
# to avoid clashing with a locally-installed Postgres that may already be listening on 5432.
DATABASE_URL="postgresql://vgosti:vgosti@localhost:5433/vgosti?schema=public"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# App
PORT=3000
NODE_ENV=development

# Fixed SMS code for every phone (App Review / local). Works in production too.
# Leave empty to issue random codes only.
AUTH_DEV_CODE="0000"

# SMS Pilot (https://smspilot.ru/) — real SMS for login codes.
# Leave empty in local/test to skip sending (code is logged / returned as devCode).
SMSPILOT_API_KEY=""
# Optional registered sender name from the SMS Pilot cabinet.
SMSPILOT_FROM=""

# Telegram "log in with Telegram" flow (test substitute for a real SMS provider).
# Create a bot via @BotFather and paste its token here. Leave empty to disable.
TELEGRAM_BOT_TOKEN=""

# Chat id where free-text messages sent to the bot (support.html links to it
# as the support contact) get forwarded, so a human sees them. Message the
# bot yourself once and check the server logs for your chat id, or ask
# @userinfobot. Leave empty to just log a warning instead of forwarding.
TELEGRAM_SUPPORT_CHAT_ID=""

# "Войти через Яндекс" / "Войти через VK" — standard OAuth2 logins.
# Base public URL the provider redirects back to after login, e.g.
# "http://95.182.83.49:3000" — the callback path (/api/v1/auth/<provider>/callback)
# is appended automatically. Leave any of these empty to disable that provider (503).
OAUTH_REDIRECT_BASE_URL=""

# Register at https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Register at https://vk.com/apps?act=manage
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# Google / Apple via Firebase Auth (client signs in → sends ID token here).
# Prefer mounting a service-account JSON and setting FIREBASE_SERVICE_ACCOUNT_PATH.
# Or paste the whole JSON into FIREBASE_SERVICE_ACCOUNT_JSON / set the three fields.
# Leave empty to disable (POST /auth/firebase returns 503).
FIREBASE_PROJECT_ID="pulse-by"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_PATH=""
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Sign in with Apple token revoke (App Store 5.1.1). Bundle ID as client_id.
# Download .p8 key from Apple Developer → Keys. Without these, deletion still
# works but Apple authorization is not revoked server-side.
APPLE_CLIENT_ID="by.pulse.app"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# YooKassa web acquiring (leave empty → mock checkout + simulate)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL="https://pulse-app.by/payments/return"
