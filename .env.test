# Isolated database for `npm run test:e2e` — never the dev/demo database,
# so tests can freely create and delete data without disturbing seeded
# accounts used for manual QA. One-time setup on a fresh checkout:
#   docker exec backend-postgres-1 psql -U vgosti -d vgosti -c "CREATE DATABASE vgosti_test;"
#   DATABASE_URL="postgresql://vgosti:vgosti@localhost:5433/vgosti_test?schema=public" npx prisma migrate deploy
DATABASE_URL="postgresql://vgosti:vgosti@localhost:5433/vgosti_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000
NODE_ENV=test

AUTH_DEV_CODE="0000"

# Deliberately empty, not omitted: @prisma/client auto-loads the real .env
# on its own (independent of this file — see the comment in app.module.ts),
# which would otherwise leak the real TELEGRAM_BOT_TOKEN in here and make the
# bot poll for real during tests, colliding with the locally-running dev
# server on the same token (409 Conflict) and hanging Nest shutdown. An
# explicit empty value here wins because dotenv never overrides a key that's
# already set in process.env.
TELEGRAM_BOT_TOKEN=

# Firebase Admin deliberately unset — Google/Apple login must 503 in tests.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMS Pilot unset in tests — request-code stays a stub (devCode / AUTH_DEV_CODE).
SMSPILOT_API_KEY=
SMSPILOT_FROM=
